{
  "name": "smartwater",
  "version": "0.1.0",
  "private": true,
  "description": "SmartWater desktop application foundation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node electron/launch.cjs --dev\"",
    "build": "vite build",
    "test": "node --test",
    "start": "node electron/launch.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "org.smartwater.desktop",
    "productName": "SmartWater",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/*.test.*"
    ],
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns"
    }
  }
}
